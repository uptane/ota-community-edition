# OTA Community Edition Web UI - Dockerfile
#
# This Dockerfile builds the web UI for OTA Community Edition.
# It uses a multi-stage build to create a production-ready nginx container.
#

# Stage 1: Build the Vue.js application
FROM node:18-alpine AS builder

WORKDIR /app

# Install build dependencies
RUN npm install -g @quasar/cli

# Copy package files first for better caching
COPY package.json yarn.lock ./

# Install dependencies
RUN yarn install --frozen-lockfile

# Copy source files
COPY . .

# Build the production SPA
RUN quasar build

# Stage 2: Production nginx container
FROM nginx:alpine

# Remove default nginx config
RUN rm /etc/nginx/conf.d/default.conf

# Copy custom nginx configuration
COPY docker-context/nginx.ce.conf /etc/nginx/conf.d/default.conf

# Copy built static files
COPY --from=builder /app/dist/spa /usr/share/nginx/html

# Expose port 80
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost/health || exit 1

# Start nginx
CMD ["nginx", "-g", "daemon off;"]
