{
  "name": "ota-frontend",
  "version": "1.1.209",
  "description": "Toradex OTA frontend",
  "productName": "Toradex OTA",
  "cordovaId": "com.toradex.ota.admin",
  "author": "Temitope Adeyeri",
  "private": true,
  "dockerTagTemplate": "topeysoft/{name}:{version}",
  "dockerGUITagTemplate": "topeysoft/{name}-gui:{version}",
  "scripts": {
    "lint": "eslint --ext .js,.vue src",
    "test": "npm run test:unit",
    "test:w": "npm run test:unit:watch",
    "test:all": "npm run test && npm run test:ui",
    "coverage": "nyc --reporter=html --reporter=text npm run test && opn ./coverage/index.html",
    "dev": "quasar dev",
    "start": "quasar dev",
    "electron:start": "quasar dev -m electron",
    "serve": "quasar serve ./dist/spa",
    "ver:build": "echo Please update version `build` manually",
    "ver:major": "echo Please update version `major` manually",
    "ver:minor": "echo Please update version `minor` manually",
    "ver:patch": "echo Please update version `patch` manually",
    "docker:start": "docker-compose down; docker-compose up",
    "docker:stop": "docker-compose down",
    "docker:build": "./docker-pre-build.sh; gulp docker:build; rm -fr ./docker-context/dist",
    "docker:tag": "gulp docker:tag",
    "docker:push": "gulp docker:push",
    "docker:publish": "npm run docker:build; npm run docker:tag; npm run docker:push",
    "build": "quasar build",
    "electron:compress": "gulp electron:compress",
    "electron:build": " ./convert-icon.sh; quasar build -m electron; npm run pack",
    "electron:release": "npm run electron:build; gulp electron:copy; gulp docker:gui:build;  gulp docker:gui:tag;  gulp docker:gui:push;",
    "info": "quasar info",
    "pack": "rm -fr ./dist/electron-out; rm -fr ./dist/electron-mat/UnPackaged/node_modules; electron-packager ./dist/electron-mat/UnPackaged 'Torizon OTA Admin' --all --out=./dist/electron-out --overwrite --icon=./icon-output/electron/icon",
    "make:icon": "iconfactory -p=kitchensink -s=./src/statics/icon-1240.png -t=./icon-output -m=pngquant -d=singlefile",
    "doc": "npm run doc:html && opn build/docs/index.html",
    "doc:html": "typedoc src/ --exclude tests/**/* --target ES6 --mode file --out build/docs",
    "doc:json": "typedoc src/ --exclude **/*.spec.ts --target ES6 --mode file --json build/docs/typedoc.json",
    "doc:publish": "gh-pages -m \"[ci skip] Updates\" -d build/docs",
    "test:unit": "jest --config ./jest.config.js",
    "test:unit:snapshot": "jest --updateSnapshot --config ./jest.config.js",
    "test:unit:coverage": "jest --coverage",
    "test:unit:watch": "jest --watchAll  --coverage=false --notify",
    "test:unit:watchAll": "jest --watchAll",
    "serve:test:coverage": "quasar serve coverage --port 8788",
    "concurrently:dev:jest": "concurrently -p \"[{name}]\" -n \"QUASAR,_JEST_\" -c \"quasar dev\" \"jest --watch\"",
    "test:e2e": "wdio ./test/webdriver/config/wdio.conf.js",
    "test:e2e:CI": "cypress run",
    "test:e2e:CI:open": "cypress open",
    "test:e2e:appium": "wdio ./test/webdriver/config/wdio.appium.conf.js",
    "test:e2e:electron": "wdio ./test/webdriver/config/wdio.electron.conf.js",
    "selenium:install": "selenium-standalone install",
    "selenium:start": "selenium-standalone start",
    "electron-chromedriver": "./node_modules/electron-chromedriver/bin/chromedriver --port=9515 --url-base=wd/hub --verbose",
    "serve:test:lighthouse": "quasar serve test/lighthouse/reports/ --port 8789",
    "audit:snyk": "snyk test --json > ./test/audits/snyk.json",
    "audit:node_modules": "yarn audit --json > ./test/audits/node_modules_audit.json",
    "audit:licenses": "nlf --summary detail > ./test/audits/licenses.txt",
    "audit:lighthouse": "lighthouse http://localhost:3000 view --output-path=./test/lighthouse/reports/index.html --config-path=./test/lighthouse/configs/full-config.js"
  },
  "dependencies": {
    "@babel/preset-env": "^7.6.3",
    "@quasar/app": "^1.4.4",
    "@quasar/extras": "^1.3.3",
    "amazon-cognito-identity-js": "^3.0.12",
    "aws-sdk": "^2.464.0",
    "axios": "^0.18.0",
    "beaver-logger": "^4.0.12",
    "change-case": "^3.1.0",
    "chart.js": "^2.9.3",
    "clipboard": "^2.0.4",
    "countries-list": "^2.5.0",
    "croppie": "^2.6.4",
    "file-saver": "^2.0.2",
    "interactjs": "^1.8.0-rc.1",
    "jquery": "^3.3.1",
    "js-cookie": "^2.2.0",
    "location": "^0.0.1",
    "moment": "^2.24.0",
    "navigator": "^1.0.1",
    "node-fetch": "^2.6.0",
    "quasar": "^1.6.1",
    "save-file": "^2.3.1",
    "shortid": "^2.2.14",
    "underscore": "^1.9.1",
    "unique-names-generator": "^4.2.0",
    "vue-chartjs": "^3.5.0",
    "vue-codemirror": "^4.0.6",
    "vue-croppie": "^2.0.1",
    "vue-drag-drop": "^1.1.4",
    "vue-i18n": "^7.3.3",
    "vue-masonry": "^0.11.8",
    "vue-niege": "^0.1.1",
    "vue-timeago": "^5.1.2",
    "vuedraggable": "^2.17.0",
    "vuelidate": "^0.7.4",
    "xlsx": "^0.15.3",
    "xmlhttprequest": "^1.8.0",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.6.0",
    "@quasar/cli": "^1.0.2",
    "@quasar/quasar-app-extension-icon-genie": "^1.1.2",
    "@quasar/quasar-app-extension-testing": "^1.0.0",
    "@quasar/quasar-app-extension-testing-e2e-cypress": "^1.0.0-beta.10",
    "@quasar/quasar-app-extension-testing-e2e-webdriver": "^1.0.0-beta.9",
    "@quasar/quasar-app-extension-testing-quality": "^1.0.0-beta.8",
    "@quasar/quasar-app-extension-testing-security": "^1.0.0-alpha.8",
    "@quasar/quasar-app-extension-testing-unit-jest": "^1.0.0",
    "@vue/test-utils": "^1.0.0-beta.29",
    "appium": "^1.12.1",
    "assert": "^1.4.1",
    "audit": "^0.0.6",
    "babel-loader": "^8.0.6",
    "chai": "^4.2.0",
    "chromedriver": "^2.46.0",
    "codeceptjs": "^2.0.4",
    "cypress": "^3.3.2",
    "devtron": "1.4.0",
    "electron": "3.0.8",
    "electron-builder": "^20.38.5",
    "electron-debug": "2.0.0",
    "electron-devtools-installer": "2.2.4",
    "electron-packager": "^12.0.1",
    "gulp": "^4.0.0",
    "gulp-gzip": "^1.4.2",
    "gulp-tar": "^2.1.0",
    "jest-cli": "^24.9.0",
    "jest-puppeteer-docker": "^1.2.0",
    "jsdom-global": "^3.0.2",
    "mocha": "^6.0.2",
    "mocha-webpack": "^1.1.0",
    "puppeteer": "^1.20.0",
    "sinon": "^7.2.7",
    "strip-ansi": "=3.0.1",
    "vue-loader": "^14.2.2",
    "wdio-appium-service": "^0.2.3",
    "wdio-chromedriver-service": "^5.0.1",
    "webpack-cli": "^3.2.3"
  },
  "engines": {
    "node": ">= 8.9.0",
    "npm": ">= 5.6.0",
    "yarn": ">= 1.6.0"
  },
  "browserslist": ["> 1%", "last 2 versions", "not ie <= 10"]
}
