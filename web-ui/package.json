{
  "name": "ota-app",
  "version": "1.1.258",
  "description": "Secure automated device provisioning and update system for Torizon platform",
  "productName": "Torizon Platform",
  "cordovaId": "com.toradex.ota.admin",
  "author": "Temitope Adeyeri",
  "private": true,
  "dockerTagTemplate": "topeysoft/{name}:{version}",
  "dockerGUITagTemplate": "topeysoft/{name}-gui:{version}",
  "scripts": {
    "dev": "quasar dev",
    "start": "quasar dev",
    "serve": "quasar serve ./dist/spa",
    "test": "npm run test:unit",
    "ver:build": "echo Please update version `build` manually",
    "ver:major": "echo Please update version `major` manually",
    "ver:minor": "echo Please update version `minor` manually",
    "ver:patch": "echo Please update version `patch` manually",
    "test:unit": "jest",
    "test:unit:us": "jest --updateSnapshot",
    "test:unit:coverage": "jest --coverage",
    "test:unit:coverage:summary": "jest --coverage --coverageReporters=\"json-summary\"",
    "test:unit:watch": "jest --watch --coverageReporters=\"text-summary\"",
    "test:unit:watchAll": "jest --watchAll",
    "test:debug": "node --inspect-brk node_modules/.bin/vue-cli-service test:unit --no-cache --watch --runInBand",
    "serve:test:coverage": "quasar serve test/jest/coverage/lcov-report/ --port 8788",
    "concurrently:dev:jest": "concurrently \"quasar dev\" \"jest --watch\"",
    "test:unit:ui": "majestic",
    "format": "prettier --write \"src/**/*.{js,vue}\""
  },
  "dependencies": {
    "@amcharts/amcharts4": "^4.10.20",
    "@popperjs/core": "^2.11.6",
    "@quasar/app": "1.9.6",
    "@quasar/extras": "^1.10.3",
    "axios": "^0.18.0",
    "beaver-logger": "^4.0.12",
    "change-case": "^3.1.0",
    "chart.js": "^2.9.3",
    "clipboard": "^2.0.4",
    "countries-list": "^2.5.0",
    "croppie": "^2.6.4",
    "crypto-js": "^4.0.0",
    "dompurify": "^2.3.5",
    "file-saver": "^2.0.2",
    "interactjs": "^1.8.0-rc.1",
    "istextorbinary": "^6.0.0",
    "jquery": "^3.3.1",
    "js-cookie": "^2.2.0",
    "keycloak-js": "^22.0.5",
    "location": "^0.0.1",
    "moment": "^2.24.0",
    "navigator": "^1.0.1",
    "node-fetch": "^2.6.0",
    "node-forge": "^1.3.1",
    "quasar": "^1.15.10",
    "rrweb": "^2.0.0-alpha.4",
    "save-file": "^2.3.1",
    "shortid": "^2.2.14",
    "showdown": "^1.9.1",
    "sortablejs": "^1.13.0",
    "underscore": "^1.9.1",
    "unique-names-generator": "^4.2.0",
    "vue-codemirror": "^4.0.6",
    "vue-croppie": "^2.0.1",
    "vue-drag-drop": "^1.1.4",
    "vue-gtag": "^1.14.0",
    "vue-i18n": "^7.3.3",
    "vue-masonry": "^0.11.8",
    "vue-niege": "^0.1.1",
    "vue-timeago": "^5.1.2",
    "vuedraggable": "^2.24.3",
    "vuelidate": "^0.7.4",
    "xlsx": "^0.15.3",
    "xmlhttprequest": "^1.8.0",
    "yamljs": "^0.3.0"
  },
  "engines": {
    "node": ">= 8.9.0",
    "npm": ">= 5.6.0",
    "yarn": ">= 1.6.0"
  },
  "browserslist": [
    "last 10 Chrome versions",
    "last 10 Firefox versions",
    "last 4 Edge versions",
    "last 7 Safari versions",
    "last 8 Android versions",
    "last 8 ChromeAndroid versions",
    "last 8 FirefoxAndroid versions",
    "last 10 iOS versions",
    "last 5 Opera versions"
  ],
  "devDependencies": {
    "@babel/runtime": "^7.15.3",
    "@quasar/quasar-app-extension-testing": "^1.0.3",
    "@quasar/quasar-app-extension-testing-unit-ava": "^1.0.0-beta.12",
    "@quasar/quasar-app-extension-testing-unit-jest": "^2.2.2",
    "chai": "^4.2.0",
    "core-js": "2.6.5",
    "eslint-plugin-jest": "^24.1.0",
    "jest": "26.4.0",
    "majestic": "^1.2.24",
    "sinon": "^9.0.3"
  }
}
